# Settings for the bank relay when it runs on your machine (npm run bank, npm run bank:check).
# Copy this file to backend/bank/.env and fill it in. .env is ignored by git: never commit keys.

# From dashboard.plaid.com → Developers → Keys. Start with the sandbox secret.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox: Plaid's test banks (user_good / pass_good). production: real banks (Trial plan or approved Production).
PLAID_ENV=sandbox

# 32 random bytes in base64. It seals the bank connection keys the app saves to each account;
# if it changes, existing connections stop working. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RELAY_KEY=

# The Firebase project whose cloud-sync sign-ins the relay accepts (projectId in js/config.js).
# Every endpoint but /health needs the app's ID token from this project. Not a secret.
FIREBASE_PROJECT_ID=worky-b3e3a
# Leave unset here. Only check.mjs and the tests set it, to serve test sign-in keys instead of
# Google's: FIREBASE_JWKS_URL=http://127.0.0.1:0/jwks npm run bank:check
# FIREBASE_JWKS_URL=

# Other web addresses allowed to call this relay (the app at http://localhost:8787 always is).
# Signing in only works on the deployed app, so to connect a bank through this relay add
# https://homiejhan.github.io and point that app at it (README, step 4).
ALLOWED_ORIGINS=

# Only for OAuth banks (Chase, Bank of America, Wells Fargo…); must be registered in the Plaid dashboard.
PLAID_REDIRECT_URI=

PORT=8787
