# Settings for the bank relay when it runs on your machine (npm run bank, npm run bank:check).
# Copy this file to backend/bank/.env and fill it in. .env is ignored by git: never commit keys.

# From dashboard.plaid.com → Developers → Keys. Start with the sandbox secret.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox: Plaid's test banks (user_good / pass_good). production: real banks (Trial plan or approved Production).
PLAID_ENV=sandbox

# 32 random bytes in base64. It seals the bank connection keys that devices hold; if it
# changes, existing connections stop working. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RELAY_KEY=

# Other web addresses allowed to call this relay (the app at http://localhost:8787 always is).
ALLOWED_ORIGINS=

# Only for OAuth banks (Chase, Bank of America, Wells Fargo…); must be registered in the Plaid dashboard.
PLAID_REDIRECT_URI=

PORT=8787
